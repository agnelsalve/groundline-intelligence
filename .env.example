# Copy this file to .env and fill in your own values. Never commit .env.

# --- AI (without any key the pipeline still runs on keyword rules and says so)
# Free Gemini key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# One model per job (each has its own free-tier quota)
GEMINI_ANALYST_MODEL=gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.8-flash
GEMINI_CHECK_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3-flash-preview,gemma-4-31b-it
# Optional extra provider: Muse Spark via the Meta Model API (https://dev.meta.ai/api-keys)
MUSE_API_KEY=your_muse_api_key_here
MUSE_MODEL=muse-spark-1.3

# --- Email delivery (Gmail SMTP with an App password; then run scripts\setup-credentials.ps1)
GMAIL_ADDRESS=your_address@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
# Where briefs and alerts go (defaults to GMAIL_ADDRESS)
ALERT_EMAIL_TO=

# --- Optional extra news source: https://newsapi.org/register
NEWSAPI_KEY=your_newsapi_key_here

# --- Tuning (defaults shown)
# Free tier = few requests per day per model: big batches, few parallel calls
AI_BATCH_SIZE=25
AI_CONCURRENCY=2
AI_MAX_RECORDS=400
# Hard cap on AI spend per pipeline run (USD). Past it, the run falls back to keyword rules.
AI_BUDGET_USD=1.00
