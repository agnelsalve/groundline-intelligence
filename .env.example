# Copy this file to .env and fill in your own values. Never commit .env.

# --- AI (at least one; without any key the pipeline still runs on keyword rules and says so)
# Muse Spark via the Meta Model API: https://developers.meta.ai  ($20 free credit for new US accounts)
MUSE_API_KEY=your_muse_api_key_here
MUSE_MODEL=muse-spark-1.3
# Backup + independent fact-checker: free Gemini key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- Email delivery (Gmail SMTP with an App password; then run scripts\setup-credentials.ps1)
GMAIL_ADDRESS=your_address@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
# Where briefs and alerts go (defaults to GMAIL_ADDRESS)
ALERT_EMAIL_TO=

# --- Optional extra news source: https://newsapi.org/register
NEWSAPI_KEY=your_newsapi_key_here

# --- Tuning (defaults shown)
AI_BATCH_SIZE=10
AI_CONCURRENCY=3
AI_MAX_RECORDS=400
# Hard cap on AI spend per pipeline run (USD). Past it, the run falls back to keyword rules.
AI_BUDGET_USD=1.00
